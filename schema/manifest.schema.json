{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://augmentoragent.com/schemas/app-manifest-v1.json",
  "title": "Augmentor application manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "harness", "instructions", "tools", "permissions", "voice"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "maxLength": 2000},
    "harness": {"enum": ["dsh", "codex"]},
    "instructions": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tools": {"type": "array", "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "module", "names"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "module": {"type": "string", "minLength": 1},
        "names": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"}}
      }
    }},
    "permissions": {"type": "object", "additionalProperties": false, "required": ["tools"], "properties": {
      "tools": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"}}
    }},
    "voice": {"type": "object", "additionalProperties": false, "required": ["experimental", "enabled"], "properties": {"experimental": {"const": true}, "enabled": {"type": "boolean"}}}
  }
}
